# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is git-ignored and will never be committed — this template is
# the only version that goes to GitHub.

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=farmadmin
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=elegoo_farm

# ── Backend ───────────────────────────────────────────────────────────────
# Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-char-random-hex-string

# Leave as true for now (matches current behavior) — controls whether the
# poller falls back to simulated status for printers it can't reach.
DEV_MODE=true
